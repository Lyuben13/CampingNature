@{
    ViewData["Title"] = "Къмпинг Природа";
}

<div class="hero-section">
    <div class="logo">🏕️ Къмпинг Природа</div>

    <div class="tagline">
        Вашето идеално къмпинг приключение започва тук
    </div>

    <a asp-controller="Camping"
       asp-action="Index"
       class="cta-button">
        Разгледайте палатките
    </a>
</div>

<div class="features-grid">

    <div class="feature-card">
        <div class="feature-icon">⛺</div>
        <h3 class="feature-title">Качествени палатки</h3>
        <p class="feature-description">
            Предлагаме висококачествени палатки за всякакви приключения на открито
        </p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🌲</div>
        <h3 class="feature-title">Природа</h3>
        <p class="feature-description">
            Открийте красотата на природата с нашето оборудване за къмпинг
        </p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">💰</div>
        <h3 class="feature-title">Достъпни цени</h3>
        <p class="feature-description">
            Най-доброто съотношение цена-качество за къмпинг оборудване
        </p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🚚</div>
        <h3 class="feature-title">Бърза доставка</h3>
        <p class="feature-description">
            Доставка до 2 работни дни във всички точки на страната
        </p>
    </div>

</div>

<div class="info-section">

    <h2 class="info-title">За Къмпинг Природа</h2>

    <p class="info-text">
        Къмпинг Природа е вашият доверен партньор в света на къмпинга.
        Ние предлагаме висококачествено оборудване за всички ваши приключения
        на открито. Подбираме практични и надеждни продукти, за да гарантираме
        вашето удобство и комфорт.
    </p>

    <p class="info-text" style="margin-top: 20px;">
        Нашата мисия е да направим къмпинга достъпен и приятен за всеки.
        Предлагаме палатки за всякакви нужди – от компактни палатки за
        планински преходи до големи семейни палатки с всички удобства.
    </p>

    <div style="text-align: center; margin-top: 30px;">
        <a asp-controller="Camping"
           asp-action="Index"
           class="cta-button cta-button-dark">
            Разгледайте палатките
        </a>
    </div>

</div>

<div class="features-grid">

    <div class="feature-card">
        <div class="feature-icon">✅</div>
        <h3 class="feature-title">Качество</h3>
        <p class="feature-description">
            Надеждни продукти за вашите приключения
        </p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">🔄</div>
        <h3 class="feature-title">Връщане</h3>
        <p class="feature-description">
            30 дни гаранция за връщане
        </p>
    </div>

    <div class="feature-card">
        <div class="feature-icon">📞</div>
        <h3 class="feature-title">Поддръжка</h3>
        <p class="feature-description">
            24/7 клиентска поддръжка
        </p>
    </div>

</div>