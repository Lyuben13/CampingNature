@model Product
@inject ImageStorageService Images

@{
    ViewData["Title"] = "Редакция";
}

<h1 class="h3">Редакция</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImagePath" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Текуща снимка</label>
                <div>
                    <img src="@Images.ToWebPath(Model.ImagePath)" alt="@Model.Name" class="img-thumbnail" style="max-width: 220px;"
                         onerror="this.onerror=null;this.src='/images/tent-placeholder.svg';" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Нова снимка</label>
                <input type="file" name="imageFile" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
                <span asp-validation-for="ImagePath" class="text-danger"></span>
                <small class="text-muted">Оставете празно, ако не искате да променяте снимката.</small>
            </div>
            <button type="submit" class="btn btn-primary">Запази</button>
            <a asp-action="Index" class="btn btn-link">Назад към списъка</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
