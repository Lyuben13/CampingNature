@model MVC.Intro.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="login-page">
    <div class="container">
        <h2 class="text-white mb-4">Register</h2>

        <div class="row">
            <div class="col-md-6">
                <form method="post" asp-action="Register">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label text-white"></label>
                        <input asp-for="Name" class="form-control" style="background: rgba(255, 255, 255, 0.7); border: none;" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label text-white"></label>
                        <input asp-for="Email" class="form-control" style="background: rgba(255, 255, 255, 0.7); border: none;" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label text-white"></label>
                        <input asp-for="Password" class="form-control" style="background: rgba(255, 255, 255, 0.7); border: none;" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ConfirmPassword" class="form-label text-white"></label>
                        <input asp-for="ConfirmPassword" class="form-control" style="background: rgba(255, 255, 255, 0.7); border: none;" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Register</button>
                </form>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Login" class="text-white">Already have an account? Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}