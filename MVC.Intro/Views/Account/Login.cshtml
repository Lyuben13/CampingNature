@model MVC.Intro.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">
    <div class="container">
        <h2 class="text-white mb-4">Login</h2>

        <div class="row">
            <div class="col-md-6">
                <form method="post" asp-action="Login">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label text-white"></label>
                        <input asp-for="Email" class="form-control" style="background: rgba(255, 255, 255, 0.7); border: none;" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label text-white"></label>
                        <input asp-for="Password" class="form-control" style="background: rgba(255, 255, 255, 0.7); border: none;" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label text-white"></label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Login</button>
                </form>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Register" class="text-white">Register as a new user</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}