<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Къмпинг Природа")</title>
    <link rel="stylesheet" href="~/css/camping.css" asp-append-version="true" />
</head>
<body class="camping-page">
    <nav class="navbar">
        <div class="nav-container">
            <a class="logo" asp-controller="Home" asp-action="Index">🏕️ Къмпинг Природа</a>
            <ul class="nav-menu">
                <li><a href="#home">Начало</a></li>
                <li><a href="#products">Палатки</a></li>
                <li><a href="#about">За нас</a></li>
                <li><a href="#contact">Контакт</a></li>
                <li><a asp-controller="Product" asp-action="Index">Каталог</a></li>
            </ul>
        </div>
    </nav>

    @RenderBody()

    <footer class="camping-footer">
        <p>&copy; @DateTime.Now.Year Къмпинг Природа. Всички права запазени.</p>
    </footer>

    <script src="~/js/camping.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
